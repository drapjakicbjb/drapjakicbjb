<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration: 1 hour
  ExpiresDefault "access plus 1 hour"

  # Images and icons: 1 year
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Web fonts: 1 year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # CSS stylesheets: 1 month
  ExpiresByType text/css "access plus 1 month"

  # JavaScript: 1 month
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # HTML pages: 0 seconds (always check for fresh content)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control headers fallback
<IfModule mod_headers.c>
  # 1 Year cache for images and fonts
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf)$">
    Header set Cache-Control "max-age=31536000, public, no-transform"
  </FilesMatch>

  # 1 Month cache for stylesheet and javascript
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # 0 Seconds cache for HTML/XML to get notices/announcements immediately
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "max-age=0, must-revalidate, public"
  </FilesMatch>
</IfModule>
