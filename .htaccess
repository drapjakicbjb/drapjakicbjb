<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration: 1 hour
  ExpiresDefault "access plus 1 hour"

  # Images and icons: 1 year
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # Web fonts: 1 year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # CSS stylesheets: 1 year
  ExpiresByType text/css "access plus 1 year"

  # JavaScript: 1 year
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML pages: 0 seconds (always check for fresh content)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cache-Control headers fallback
<IfModule mod_headers.c>
  # 1 Year cache for images and fonts
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf)$">
    Header set Cache-Control "max-age=31536000, public, no-transform"
  </FilesMatch>

  # 1 Year cache for stylesheet and javascript
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # 0 Seconds cache for HTML/XML to get notices/announcements immediately
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "max-age=0, must-revalidate, public"
  </FilesMatch>

  # Link headers for agent discovery on the homepage (RFC 8288)
  <Files "index.html">
    Header add Link "</.well-known/api-catalog>; rel=\"api-catalog\""
    Header add Link "</.well-known/agent-skills/index.json>; rel=\"agent-skills\""
  </Files>
</IfModule>

# Force correct MIME type for API Catalog
<Files "api-catalog">
  ForceType application/linkset+json
</Files>

